<!DOCTYPE html>
<html lang="{{ page.lang }}">
    <head>
    {% include "partials/head.njk" %}
    </head>
    <body>
        <a href="#main-content" class="skip-link">{{ languages[page.lang].skipToContent }}</a>
        <div class="container">
            {% include "partials/header.njk" %}
            <main class="page" id="main-content">{{ content | safe }}</main>
            {% include "partials/footer.njk" %}
        </div>
        {%- if layout == "project.njk" %}
        <div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-label="{{ languages[page.lang].lightbox.label }}" data-zoom-label="{{ languages[page.lang].lightbox.zoomDiagram }}" hidden>
            <button type="button" class="lightbox__close" aria-label="{{ languages[page.lang].lightbox.close }}">×</button>
            <button type="button" class="lightbox__nav lightbox__nav--prev" data-lightbox-prev aria-label="{{ languages[page.lang].shots.prev }}" hidden><svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg></button>
            <figure class="lightbox__figure">
                <figcaption class="lightbox__caption" aria-live="polite"></figcaption>
            </figure>
            <button type="button" class="lightbox__nav lightbox__nav--next" data-lightbox-next aria-label="{{ languages[page.lang].shots.next }}" hidden><svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg></button>
        </div>
        {%- endif %}
        <script src="/scripts.js" defer></script>
        {% if layout == "project.njk" %}<script src="/media.js" defer></script>{% endif %}
        {% include "partials/matomo.njk" %}
    </body>
</html>

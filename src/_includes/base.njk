<!DOCTYPE html>
<html lang="{{ page.lang }}">
    <head>
    {% include "partials/head.njk" %}
    </head>
    <body>
        <a href="#main-content" class="skip-link">{{ languages[page.lang].skipToContent }}</a>
        <div class="container">
            {% include "partials/header.njk" %}
            <main class="page" id="main-content">{{ content | safe }}</main>
            {% include "partials/footer.njk" %}
        </div>
        <script src="/scripts.js" defer></script>
        {% if screenshots and screenshots.length > 1 %}<script src="/carousel.js" defer></script>{% endif %}
        {% include "partials/matomo.njk" %}
    </body>
</html>

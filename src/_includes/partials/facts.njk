{#- Key facts band. items: [{ label, value }] — usually the page's `facts` front matter. -#}
{%- macro factsBand(items) -%}
{%- if items and items.length -%}
<dl class="facts">
{%- for item in items %}
<div class="facts__item"><dt>{{ item.label }}</dt><dd>{{ item.value }}</dd></div>
{%- endfor %}
</dl>
{%- endif -%}
{%- endmacro -%}

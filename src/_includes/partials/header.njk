<header class="site-header">
    <nav class="nav" aria-label="{{ languages[page.lang].navLabel }}">
        {% for item in navigation[page.lang] %}
        <a class="nav__link" href="{{ item.url }}" {% if page.url | startsWith(item.prefix) %}aria-current="page"{% endif %}>{{ item.text }}</a>
        {% endfor %}
        <button type="button" id="theme-toggle" class="theme-toggle" aria-label="{{ languages[page.lang].theme.toDark }}" aria-pressed="false">
            <svg class="theme-toggle__moon" aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
            <svg class="theme-toggle__sun" aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        </button>
    </nav>
</header>
